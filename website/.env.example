# Copy to .env.local for local development, and add the same values in
# Vercel -> Project -> Settings -> Environment Variables for the live site.

# Your live domain, e.g. https://www.fairtrade23.co.uk
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe: dashboard.stripe.com -> Developers -> API keys (use sk_test_... while testing)
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe: Developers -> Webhooks -> add endpoint https://YOURDOMAIN/api/stripe-webhook
# (event: checkout.session.completed) and paste its signing secret here
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Email for the quote form and payment notifications (Gmail example).
# Create an App Password: Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=trtanev23@gmail.com
SMTP_PASS=your-16-character-app-password
# Where enquiries are sent (defaults to the email in src/lib/site.ts)
ENQUIRY_EMAIL=trtanev23@gmail.com
