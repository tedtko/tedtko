# Add these in Vercel -> Project -> Settings -> Environment Variables.

NEXT_PUBLIC_SITE_URL=https://fairtradedesign.pro

# Stripe (dashboard.stripe.com -> Developers -> API keys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# OR hosted payment links (e.g. Dodo Payments). If set, these override Stripe for that pack.
# PAYMENT_LINK_ESSENTIAL=https://...
# PAYMENT_LINK_STANDARD=https://...
# PAYMENT_LINK_PREMIUM=https://...
# Euro versions for the German/French/Spanish/Italian site:
# PAYMENT_LINK_ESSENTIAL_EUR=https://...
# PAYMENT_LINK_STANDARD_EUR=https://...
# PAYMENT_LINK_PREMIUM_EUR=https://...

# Email for contact/intake forms (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=trtanev23@gmail.com
SMTP_PASS=your-16-character-app-password
ENQUIRY_EMAIL=studio@fairtradedesign.pro

# Optional analytics (only loads after cookie consent)
# NEXT_PUBLIC_GA_ID=G-XXXXXXX
